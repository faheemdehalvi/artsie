/workspace/
# Runtime state and secrets
/logs/
/data/photocraft-control-token
/data/hub-start.lock
*.log
install.log
# Build and dependency output
node_modules/
__pycache__/
*.pyc
.DS_Store
# Generated by setup (CLI links and the machine-specific artsie launcher)
/bin/
